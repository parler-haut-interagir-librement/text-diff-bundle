{
    "name": "phil/text-diff-bundle",
    "description": "phil/text-diff in Symfony: the differ with its bound of edits, the text_diff and text_diff_document Twig filters, a Stimulus comparison controller that switches between the inline, old and new views and steps from change to change, and a stylesheet",
    "license": "MIT",
    "type": "symfony-bundle",
    "keywords": [
        "diff",
        "revisions",
        "twig",
        "stimulus",
        "ujo",
        "symfony-bundle"
    ],
    "authors": [
        {
            "name": "Philippe Gamache",
            "email": "philippe@ph-il.ca",
            "homepage": "https://github.com/ph-il",
            "role": "Developer"
        }
    ],
    "homepage": "https://ph-il.ca",
    "require": {
        "php": ">=8.5",
        "phil/text-diff": "^0.1@dev",
        "phil/ujo": "^0.1@dev",
        "symfony/config": "^8.2",
        "symfony/dependency-injection": "^8.2"
    },
    "require-dev": {
        "phil/ujo-bundle": "^0.1@dev",
        "phpunit/phpunit": "^13.4",
        "psr/log": "^3.0",
        "symfony/asset-mapper": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/form": "^8.2",
        "symfony/framework-bundle": "^8.2",
        "symfony/html-sanitizer": "^8.2",
        "symfony/http-kernel": "^8.2",
        "symfony/options-resolver": "^8.2",
        "symfony/twig-bridge": "^8.2",
        "symfony/twig-bundle": "^8.2",
        "symfony/validator": "^8.2",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "phil/ujo-bundle": "To read documents and render their blocks with the application's block types",
        "symfony/asset-mapper": "To serve the controller and the stylesheet without a build step",
        "symfony/html-sanitizer": "To compare HTML that a template does not mark safe, sanitized rather than escaped",
        "symfony/stimulus-bundle": "For the comparison controller",
        "twig/twig": "For the text_diff and text_diff_document filters"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Phil\\TextDiffBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phil\\TextDiffBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
